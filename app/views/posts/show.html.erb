<div class="container pt-4">
  <div class="row mb-3">
    <div class="col-lg-8 offset-lg-2">
      <h1 class="text-center mb-4"><%= t('.title') %></h1>
      
      <article class="card shadow-sm">
        <div class="card-body p-4">
          
          <div class="d-flex justify-content-between align-items-center mb-2">
            <h3 class="card-title mb-0"><%= @post.title %></h3>
            
            <div class="d-flex">
              <%= link_to edit_post_path(@post), id: "button-edit-#{@post.id}", class: "text-primary" do %>
                <i class="bi bi-pencil-fill"></i>
              <% end %>
              <%= link_to post_path(@post), id: "button-delete-#{@post.id}", class: "text-danger ms-3", data: { turbo_method: :delete, turbo_confirm: '本当に削除しますか？' } do %>
                <i class="bi bi-trash-fill"></i>
              <% end %>
            </div>
          </div>

          <div class="text-muted mb-4" style="font-size: 0.9em;">
            <span class="me-3"><i class="bi bi-person"></i> <%= "by #{@post.user.name}" %></span>
            <span><i class="bi bi-clock"></i> <%= l @post.created_at, format: :long %></span>
          </div>

          <div class="card-text border-top pt-3">
            <%= simple_format(@post.body) %>
          </div>
          
        </div>
      </article>
    </div>
  </div>
</div>