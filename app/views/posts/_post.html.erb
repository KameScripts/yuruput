<div class="col-sm-8 col-lg-4 mb-3">
  <div id="post-id-<%= post.id %>">
    <div class="card">
      <div class="card-body">
        <div class="d-flex">
          <h4 class="card-title">
            <%= link_to post.title, post_path(post) %>
          </h4>
          <div class='ms-auto'>
            <%= link_to edit_post_path(post), id: "button-edit-#{post.id}", class: "text-primary" do %>
              <i class="bi bi-pencil-fill"></i>
            <% end %>
            <%= link_to post_path(post), id: "button-delete-#{post.id}", class: "text-danger ms-1", data: { turbo_method: :delete, turbo_confirm: '本当に削除しますか？' } do %>
              <i class="bi bi-trash-fill"></i>
            <% end %>
          </div>
        </div>
        <ul class="list-inline">
          <li><i class="bi bi-person"></i><%= post.user.name %></li>
        </ul>
        <p class="card-text"><%= post.body %></p>
      </div>
    </div>
  </div>
</div>